<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="TOP_RIGHT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="600.0" prefWidth="990.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.Dashboard">
   <children>
      <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefWidth="315.0" style="-fx-background-color: DEDEDE; -fx-border-style: solid;" HBox.hgrow="ALWAYS">
         <HBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </HBox.margin>
         <top>
            <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" prefHeight="50.0" styleClass="labels" text="Inventory Panel" textAlignment="CENTER" BorderPane.alignment="CENTER">
               <font>
                  <Font name="Gadugi Bold" size="14.0" />
               </font>
            </Label>
         </top>
         <center>
            <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10.0" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label fx:id="inventoryCashLabel" text="Money: $0.00">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <ListView fx:id="inventoryListView" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </center>
      </BorderPane>

      <TabPane fx:id="OrderPanel" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefWidth="315.0" style="-fx-border-style: solid;" tabClosingPolicy="UNAVAILABLE" HBox.hgrow="ALWAYS">
        <tabs>
         <Tab text="Order Panel">
         <content>
                  <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
                     <center>
                        <ListView fx:id="orderListView" BorderPane.alignment="CENTER" />
                     </center>
                     <bottom>
                        <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" spacing="10.0" BorderPane.alignment="CENTER">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                           </padding>
                           <children>
                              <Button fx:id="loadButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Load" HBox.hgrow="ALWAYS">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Button>
                              <Button fx:id="cookNextOrderButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Cook Next Order" HBox.hgrow="ALWAYS">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Button>
                              <Button fx:id="saveButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Save" HBox.hgrow="ALWAYS">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Button>
                           </children>
                        </HBox>
                     </bottom>
                  </BorderPane>
         </content>
         </Tab>
          <Tab fx:id="SystemPanel" text="System Log">
            <content>
               <ListView fx:id="logListView" />
            </content>
          </Tab>
        </tabs>
         <HBox.margin>
            <Insets bottom="10.0" right="10.0" top="10.0" />
         </HBox.margin>
      </TabPane>

      <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefWidth="315.0" style="-fx-background-color: DEDEDE; -fx-border-style: solid;" HBox.hgrow="ALWAYS">
         <HBox.margin>
            <Insets bottom="10.0" right="10.0" top="10.0" />
         </HBox.margin>
         <top>
            <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" prefHeight="50.0" styleClass="labels" text="Restock Panel" textAlignment="CENTER" BorderPane.alignment="CENTER">
               <font>
                  <Font name="Gadugi Bold" size="14.0" />
               </font>
            </Label>
         </top>
         <center>
            <VBox maxWidth="1.7976931348623157E308" spacing="14.0" BorderPane.alignment="TOP_CENTER">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label text="Ingredient" />
                  <ComboBox fx:id="ingredientComboBox" maxWidth="1.7976931348623157E308" prefHeight="31.0" />
                  <Label fx:id="selectedIngredientAmountLabel" text="In stock: 0" />
                  <Label fx:id="budgetLabel" text="Cash: $0.00" />
                  <Button fx:id="buyIngredientButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Buy Ingredient">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</HBox>
